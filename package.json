{
  "name": "price-atlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "worker": "tsx apps/worker/index.ts",
    "test:e2e": "playwright test",
    "test:api": "node scripts/smoke-api.mjs",
    "backup": "tsx scripts/backup.ts",
    "backup:check": "tsx scripts/check-backup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "bullmq": "6.3.11",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "type": "module"
}
