# Local demo or isolated real catalog. Set live explicitly on web and worker.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
ATLAS_DB_PATH=./data/atlas.sqlite
ADMIN_TOKEN=
# Required in live mode. Use Supabase's recommended connection/pooler URL.
DATABASE_URL=
DB_POOL_SIZE=3
SUPABASE_URL=
SUPABASE_ANON_KEY=
# TCP Redis; Upstash REST URLs cannot be used by BullMQ.
REDIS_URL=
COLLECTION_INTERVAL_MINUTES=60
# Direct development collection or configured proxy; no automatic paid escalation.
SCRAPER_PROVIDER=direct
SCRAPINGBEE_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
SCRAPER_RENDER_JS=false
SCRAPER_PREMIUM_PROXY=false
# Retailer tracking defaults enable history (30 days), alerts and exact variant matching.
# Shared daily request limit across public imports and scheduled collection.
SCRAPER_REQUESTS_PER_DAY=1000
SCRAPER_DIRECT_FIRST=true
# Conservative, shared worst-case reservations. UTC calendar day/month, not provider billing.
SCRAPER_CREDITS_PER_DAY=100
SCRAPER_CREDITS_PER_MONTH=300
SCRAPER_MAX_CREDITS=10
# Additional per-public-lookup paid allowance, across all selected sources.
LOOKUP_MAX_CREDITS=4
CATALOG_INTERVAL_MINUTES=1440
# Database polling avoids idle BullMQ commands on metered Upstash plans.
WORKER_QUEUE=database
WORKER_SCRAPER_PREMIUM_PROXY=false
WORKER_SCRAPER_RENDER_JS=false
# Configure documented source capabilities only after reviewing actual permissions.
SOURCE_POLICIES_JSON=
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_LINK_ORIGIN=https://price-atlas-ashen.vercel.app
# Generate a random secret of at least 32 characters; same on web and worker.
UNSUBSCRIBE_SECRET=
RESEND_WEBHOOK_SECRET=
# BotFather credentials; token remains server-side. Same webhook secret on Vercel and worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ORIGIN=https://price-atlas-ashen.vercel.app
# Comma-separated approved Supabase UUIDs; administrator access also requires MFA.
ADMIN_USER_IDS=
